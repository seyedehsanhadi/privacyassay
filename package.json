{
  "name": "privacyassay",
  "version": "0.9.2",
  "description": "One HTML file that shows what a website can read about your browser, and scores how much of it your browser hides. Runs on-device, uploads nothing.",
  "type": "module",
  "bin": {
    "privacyassay": "bin/privacyassay.mjs"
  },
  "files": [
    "LICENSE",
    "index.html",
    "bin/privacyassay.mjs",
    "serve.py",
    "schema.json",
    "METHODOLOGY.md",
    "methodology.html",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\" \"test/helpers/extract.test.mjs\"",
    "test:browser": "node --test --test-concurrency=1 --test-timeout=1800000 \"test/browser/*.test.mjs\" \"test/helpers/browser.test.mjs\"",
    "test:stress": "node test/stress.mjs 6",
    "test:all": "npm test && npm run test:browser && npm run test:stress",
    "bench": "node bin/privacyassay.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "author": "Seyed Ehsan Hadi",
  "homepage": "https://github.com/seyedehsanhadi/privacyassay",
  "keywords": [
    "fingerprint",
    "privacy",
    "benchmark",
    "browser-fingerprinting",
    "anti-fingerprinting",
    "ci"
  ]
}
